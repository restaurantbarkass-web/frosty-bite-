rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Phase 4: Validation Blueprints
    
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['customer', 'admin', 'rider'] &&
             data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().size() >= 3;
    }

    function isValidMenuItem(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.available is bool;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.phone is string && data.phone.size() <= 15 &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'confirmed', 'out-for-delivery', 'delivered', 'cancelled'] &&
             data.address is string && data.address.size() <= 500 &&
             data.createdAt == request.time;
    }

    function isValidRider(data) {
      return data.uid is string && data.name is string &&
             data.status in ['available', 'busy', 'offline'];
    }

    function isValidAppConfig(data) {
      return data.isOrderingOpen is bool;
    }

    // --- Collections ---

    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                    incoming().role == existing().role && // Prevent self-role-escalation
                    isValidUser(incoming());
    }

    // MENU
    match /menu/{itemId} {
      allow read: if true; // Public menu
      allow write: if isAdmin() && isValidMenuItem(incoming());
    }

    // ORDERS
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin() || existing().riderId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || resource.data.riderId == request.auth.uid);
      
      allow create: if isSignedIn() && isValidOrder(incoming());
      
      allow update: if isSignedIn() && (
        // Admin: Full update
        (isAdmin() && isValidOrder(incoming())) ||
        // User: Only cancel if pending
        (isOwner(existing().userId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         existing().status == 'pending' &&
         incoming().status == 'cancelled') ||
        // Rider: Update status
        (existing().riderId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         incoming().status in ['out-for-delivery', 'delivered'])
      );
    }

    // RIDERS
    match /riders/{riderId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(riderId);
    }

    // APP CONFIG
    match /settings/appConfig {
      allow read: if true;
      allow write: if isAdmin() && isValidAppConfig(incoming());
    }
    
    // ADMINS (Internal collection for role checking)
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Managed in Firebase Console
    }
  }
}
