rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && 
             "email_verified" in request.auth.token && 
             request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOrderingOpen() {
      return get(/databases/$(database)/documents/settings/appConfig).data.isOrderingOpen == true;
    }

    // Admin check logic
    function isAdmin() {
      return isSignedIn() && (
        ("email" in request.auth.token && 
         request.auth.token.email.lower() in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com", "sayedazainab216@gmail.com", "sayedazainabali76@gmail.com"]) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Entity Validators (The Blueprints)
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().size() >= 3 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['customer', 'admin', 'rider'];
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'available', 'stockQuantity']) &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stockQuantity is number && data.stockQuantity >= 0 &&
             data.category is string &&
             data.available is bool &&
             (!('image' in data) || (data.image is string && data.image.size() <= 2000000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    function isValidOrderSchema(data) {
      return data.keys().hasAll(['userId', 'customerName', 'phone', 'items', 'total', 'status', 'address', 'paymentMethod', 'createdAt']) &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 15 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'confirmed', 'assigned', 'preparing', 'out_for_delivery', 'delivered', 'cancelled'] &&
             data.address is string && data.address.size() <= 1000 &&
             data.paymentMethod in ['upi', 'cod', 'card', 'cash', 'online'] &&
             data.userId is string && 
             // Allow both timestamp and string for legacy/migration if needed, but prefer timestamp
             (data.createdAt is timestamp || data.createdAt is string) &&
             (!('subtotal' in data) || (data.subtotal is number)) &&
             (!('discount' in data) || (data.discount is number)) &&
             (!('couponCode' in data) || (data.couponCode is string || data.couponCode == null)) &&
             (!('utr' in data) || (data.utr is string && data.utr.size() <= 128)) &&
             (!('paymentStatus' in data) || (data.paymentStatus is string)) &&
             (!('orderId' in data) || (data.orderId is string)) &&
             (!('riderId' in data) || (data.riderId is string)) &&
             (!('riderName' in data) || (data.riderName is string)) &&
             (!('estimatedDeliveryTime' in data) || (data.estimatedDeliveryTime is number)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidOrder(data) {
      return isValidOrderSchema(data) &&
             (data.userId == request.auth.uid || data.userId == 'guest') &&
             data.createdAt == request.time;
    }

    function isValidRider(data) {
      return data.keys().hasAll(['uid', 'name', 'status']) &&
             data.uid is string && data.name is string && data.name.size() <= 100 &&
             data.status in ['online', 'busy', 'offline'];
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll(['isOrderingOpen']) &&
             data.isOrderingOpen is bool;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'type', 'value', 'minOrder', 'expiryDate', 'usageLimit', 'usageCount', 'status']) &&
             data.code is string && data.code.size() <= 50 &&
             data.type in ['percentage', 'fixed'] &&
             data.value is number && data.value >= 0 &&
             data.minOrder is number && data.minOrder >= 0 &&
             data.expiryDate is string &&
             data.usageLimit is number && data.usageLimit >= 0 &&
             data.usageCount is number && data.usageCount >= 0 &&
             data.status in ['active', 'expired', 'disabled'] &&
             (!('isFirstOrderOnly' in data) || data.isFirstOrderOnly is bool) &&
             (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string)) &&
             (!('serverCreatedAt' in data) || data.serverCreatedAt is timestamp);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['orderId', 'userId', 'customerName', 'rating', 'comment', 'createdAt']) &&
             data.orderId is string &&
             data.userId == request.auth.uid &&
             data.customerName is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.createdAt == request.time;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------

    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                    incoming().role == existing().role && 
                    isValidUser(incoming());

      // WISHLIST
      match /wishlist/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // MENU
    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMenuItem(incoming());
      allow delete: if isAdmin();
    }

    // ORDERS
    match /orders/{orderId} {
      allow get: if isSignedIn() || resource.data.userId == 'guest' || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || (resource.data.keys().hasAll(['riderId']) && resource.data.riderId == request.auth.uid));
      
      allow create: if isOrderingOpen() && isValidOrder(incoming());
      
      allow update: if isAdmin() || (
        (isSignedIn() || existing().userId == 'guest') && (
          // User/Guest action: Cancel if pending
          ((isOwner(existing().userId) || existing().userId == 'guest') && 
           incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
           existing().status == 'pending' &&
           incoming().status == 'cancelled') ||
          // User/Guest action: Submit UTR for Admin Verification
          ((isOwner(existing().userId) || existing().userId == 'guest') &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'utr', 'paymentStatus', 'updatedAt']) &&
           existing().status == 'pending' &&
           incoming().status == 'pending' &&
           incoming().paymentStatus == 'pending_verification' &&
           incoming().utr is string && incoming().utr.size() >= 10) ||
          // Rider action: Update delivery status
          (existing().keys().hasAll(['riderId']) && existing().riderId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
           incoming().status in ['out_for_delivery', 'delivered'])
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().userId) && existing().status == 'pending' && (request.time > existing().createdAt + duration.value(60, 'm')));
    }

    // RIDERS
    match /riders/{riderId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(riderId) && isValidRider(incoming()));
    }

    // SETTINGS (App Config & Theme)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ADMINS
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // System managed
    }
    
    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || isOwner(incoming().userId);
      allow update: if isOwner(resource.data.userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId);
    }

    // COUPONS
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCoupon(incoming());
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount']) &&
        incoming().usageCount == existing().usageCount + 1
      );
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming()) &&
                    get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid &&
                    get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.status == 'delivered';
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }
  }
}
