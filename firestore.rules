rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions (The Primitives)
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && 
             request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // RBAC: Admin check via trusted collection lookup with multi-layered secure fallbacks
    // Hardened against email spoofing by requiring authenticated administration emails.
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        // Trust developer-verified JWT claims (role and isAdmin checks) safely checking presence
        (request.auth.token != null && (
          ('role' in request.auth.token && request.auth.token.role == 'admin') ||
          ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
          (
            'email' in request.auth.token && (
              request.auth.token.email in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com", "sayedazainab216@gmail.com", "sayedazainabali76@gmail.com", "RESTAURANTBARKASS@GMAIL.COM", "WASIFMD924@GMAIL.COM", "SAYEDAZAINAB216@GMAIL.COM", "SAYEDAZAINABALI76@GMAIL.COM"] ||
              request.auth.token.email.matches('(?i)^(restaurantbarkass|wasifmd924|sayedazainab216|sayedazainabali76)@gmail\\.com$')
            )
          )
        )) ||
        // Dynamic look up fallback in synced users collection:
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (
            'email' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com", "sayedazainab216@gmail.com", "sayedazainabali76@gmail.com", "RESTAURANTBARKASS@GMAIL.COM", "WASIFMD924@GMAIL.COM", "SAYEDAZAINAB216@GMAIL.COM", "SAYEDAZAINABALI76@GMAIL.COM"] ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.matches('(?i)^(restaurantbarkass|wasifmd924|sayedazainab216|sayedazainabali76)@gmail\\.com$')
            )
          )
        ))
      );
    }

    // Check if the business is accepting orders
    function isOrderingOpen() {
      return get(/databases/$(database)/documents/settings/appConfig).data.isOrderingOpen == true;
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Schema Enforcement)
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('full_name' in data) || (data.full_name is string && data.full_name.size() <= 128)) &&
             (!('role' in data) || (data.role in ['customer', 'admin'])) &&
             // Size guards for common optional fields
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('points' in data) || (data.points is number && data.points >= 0)) &&
             (!('wallet_balance' in data) || (data.wallet_balance is number && data.wallet_balance >= 0)) &&
             (!('badge_tier' in data) || (data.badge_tier is string && data.badge_tier.size() <= 50)) &&
             (!('total_orders' in data) || (data.total_orders is number && data.total_orders >= 0)) &&
             (!('lifetime_spend' in data) || (data.lifetime_spend is number && data.lifetime_spend >= 0)) &&
             (!('activity_streak' in data) || (data.activity_streak is number && data.activity_streak >= 0)) &&
             (!('referral_count' in data) || (data.referral_count is number && data.referral_count >= 0)) &&
             (!('review_count' in data) || (data.review_count is number && data.review_count >= 0)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('deleted' in data) || data.deleted is bool) &&
             (!('deleted_at' in data) || (data.deleted_at is string && data.deleted_at.size() <= 100)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('avatar_config' in data) || data.avatar_config is map) &&
             (!('avatar_url' in data) || (data.avatar_url == null || (data.avatar_url is string && data.avatar_url.size() <= 2000))) &&
             (!('avatar_style' in data) || (data.avatar_style is string && data.avatar_style.size() <= 64)) &&
             (!('avatar_vibe' in data) || (data.avatar_vibe is string && data.avatar_vibe.size() <= 64)) &&
             (!('avatar_generation_count' in data) || (data.avatar_generation_count is number && data.avatar_generation_count >= 0)) &&
             (!('ai_usage_stats' in data) || data.ai_usage_stats is map) &&
             (!('reward_points' in data) || (data.reward_points is number && data.reward_points >= 0)) &&
             (!('updated_at' in data) || (data.updated_at is timestamp));
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'available', 'stock_quantity']) &&
             data.name is string && data.name.size() <= 128 &&
             data.price is number && data.price >= 0 &&
             data.stock_quantity is number && data.stock_quantity >= 0 &&
             data.category is string && data.category.size() <= 100 &&
             data.available is bool &&
             (!('image' in data) || (data.image is string && data.image.size() <= 2000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidOrder(data) {
      return (!('customer_name' in data) || (data.customer_name is string && data.customer_name.size() <= 128)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20)) &&
             (!('items' in data) || (data.items is list && data.items.size() > 0 && data.items.size() <= 50)) &&
             (!('total' in data) || (data.total is number && data.total >= 0)) &&
             (!('status' in data) || (data.status in ['pending', 'confirmed', 'preparing', 'delivered', 'cancelled'])) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 1000)) &&
             (!('payment_method' in data) || (data.payment_method is string && data.payment_method.size() <= 50)) &&
             (!('user_id' in data) || (data.user_id == request.auth.uid || data.user_id == 'guest')) &&
             (!('created_at' in data) || (data.created_at is timestamp)) &&
             (!('discount' in data) || data.discount is number) &&
             (!('coupon_code' in data) || (data.coupon_code is string && data.coupon_code.size() <= 50)) &&
             (!('utr' in data) || (data.utr is string && data.utr.size() <= 128)) &&
             (!('payment_status' in data) || (data.payment_status is string && data.payment_status.size() <= 100)) &&
             (!('updated_at' in data) || (data.updated_at is timestamp));
    }

    function isValidReview(data) {
      return (!('order_id' in data) || (data.order_id is string && data.order_id.size() <= 128)) &&
             (!('user_id' in data) || (data.user_id == request.auth.uid)) &&
             (!('customer_name' in data) || (data.customer_name is string && data.customer_name.size() <= 128)) &&
             (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 2000)) &&
             (!('created_at' in data) || (data.created_at is timestamp));
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'type', 'value', 'min_order', 'expiry_date', 'usage_limit', 'usage_count', 'status']) &&
             data.code is string && data.code.size() <= 50 &&
             data.type in ['percentage', 'fixed'] &&
             data.value is number && data.value >= 0 &&
             data.min_order is number && data.min_order >= 0 &&
             data.expiry_date is string && data.expiry_date.size() <= 100 &&
             data.usage_limit is number && data.usage_limit >= 0 &&
             data.usage_count is number && data.usage_count >= 0 &&
             data.status in ['active', 'expired', 'disabled'];
    }

    function isValidNotification(data) {
      return (!('user_id' in data) || (data.user_id is string && data.user_id.size() <= 128)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
             (!('type' in data) || (data.type in ['order', 'system'])) &&
             (!('read' in data) || (data.read is bool)) &&
             (!('created_at' in data) || (data.created_at is timestamp)) &&
             (!('link' in data) || (data.link is string && data.link.size() <= 2000));
    }

    function isValidBadgeConfig(data) {
      return data.keys().hasAll(['tierName', 'minOrders', 'minSpend', 'priority']) &&
             data.tierName is string && data.tierName.size() <= 100 &&
             data.minOrders is number &&
             data.minSpend is number &&
             data.priority is number &&
             (!('benefits' in data) || data.benefits is list) &&
             (!('themeColor' in data) || data.themeColor is string) &&
             (!('badgeIcon' in data) || data.badgeIcon is string);
    }

    function isValidGift(data) {
      return data.keys().hasAll(['title', 'requiredTier', 'stock', 'active']) &&
             data.title is string && data.title.size() <= 200 &&
             data.requiredTier is string &&
             data.stock is number &&
             data.active is bool;
    }

    function isValidWishlistItem(data) {
      return (!('user_id' in data) || data.user_id == request.auth.uid) &&
             (!('item_id' in data) || (data.item_id is string && data.item_id.size() <= 128)) &&
             (!('added_at' in data) || (data.added_at is timestamp));
    }

    function isValidBanner(data) {
      return data.keys().hasAll(['title', 'image', 'is_active', 'priority']) &&
             data.title is string && data.title.size() <= 200 &&
             data.image is string && data.image.size() <= 2000 &&
             data.is_active is bool &&
             data.priority is number &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('redirect_url' in data) || (data.redirect_url is string && data.redirect_url.size() <= 2000)) &&
             (!('is_flash_deal' in data) || data.is_flash_deal is bool) &&
             (!('auto_apply_coupon' in data) || (data.auto_apply_coupon is string && data.auto_apply_coupon.size() <= 50));
    }

    function isValidSettings(settingId, data) {
      return (settingId == 'appConfig' && 
              (!('isOrderingOpen' in data) || data.isOrderingOpen is bool) &&
              (!('deliveryBaseFee' in data) || data.deliveryBaseFee is number) &&
              (!('deliveryFeePerKm' in data) || data.deliveryFeePerKm is number) &&
              (!('deliveryFreeKm' in data) || data.deliveryFreeKm is number)) ||
             (settingId == 'theme' && 
              (!('primaryColor' in data) || data.primaryColor is string) &&
              (!('secondaryColor' in data) || data.secondaryColor is string));
    }

    function isValidServiceZone(data) {
      return data.keys().hasAll(['city_name', 'latitude', 'longitude', 'radius_meters', 'is_active']) &&
             data.city_name is string && data.city_name.size() <= 128 &&
             data.latitude is number &&
             data.longitude is number &&
             data.radius_meters is number && data.radius_meters >= 0 &&
             data.is_active is bool;
    }

    function isValidDeliveryArea(data) {
      return data.keys().hasAll(['area_name', 'pincode', 'is_deliverable']) &&
             data.area_name is string && data.area_name.size() <= 200 &&
             data.pincode is string && data.pincode.size() == 6 &&
             data.is_deliverable is bool;
    }

    function isValidServicePincode(data) {
      return data.keys().hasAll(['pincode', 'active']) &&
             data.pincode is string && data.pincode.size() == 6 &&
             data.active is bool;
    }

    function isValidNotifyRequest(data) {
      return data.email is string && data.email.size() <= 256 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 200)) &&
             (!('coords' in data) || (data.coords == null || data.coords is map)) &&
             (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 100));
    }

    // -------------------------------------------------------------------------
    // Match Blocks
    // -------------------------------------------------------------------------

    // SERVICE ZONES: Publicly viewable, Admin managed
    match /service_zones/{zoneId} {
      allow get: if isValidId(zoneId);
      allow list: if true;
      allow create: if isValidId(zoneId) && isAdmin() && isValidServiceZone(incoming());
      allow update: if isValidId(zoneId) && isValidServiceZone(incoming()) && isAdmin();
      allow delete: if isValidId(zoneId) && isAdmin();
    }

    // NOTIFICATIONS: User private alerts
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isOwner(existing().user_id);
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isValidId(notificationId) && isSignedIn() && (isAdmin() || incoming().user_id == request.auth.uid) && 
                    incoming().keys().hasAll(['user_id', 'title', 'message', 'type', 'read', 'created_at']) &&
                    isValidNotification(incoming()) &&
                    incoming().created_at == request.time;
      allow update: if isValidId(notificationId) && isValidNotification(incoming()) && (isAdmin() || isOwner(existing().user_id)) && 
                    (
                      // Action: Mark as Read
                      (incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                       incoming().read is bool) ||
                      isAdmin()
                    );
      allow delete: if isValidId(notificationId) && (isAdmin() || isOwner(existing().user_id));
    }

    // USERS: PII Isolation - Private by default
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && 
                    incoming().keys().hasAll(['uid', 'email', 'role', 'full_name']) &&
                    isValidUser(incoming()) && (
        // Only allow 'customer' role for standard sign-ups unless they are bootstrap admins
        incoming().role == 'customer' || isAdmin() || 
        (request.auth.token != null && 
         'email' in request.auth.token && (
          request.auth.token.email in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com", "sayedazainab216@gmail.com", "sayedazainabali76@gmail.com", "RESTAURANTBARKASS@GMAIL.COM", "WASIFMD924@GMAIL.COM", "SAYEDAZAINAB216@GMAIL.COM", "SAYEDAZAINABALI76@GMAIL.COM"] ||
          request.auth.token.email.matches('(?i)^(restaurantbarkass|wasifmd924|sayedazainab216|sayedazainabali76)@gmail\\.com$')
        ))
      );
      allow update: if isValidId(userId) && isValidUser(incoming()) && (isOwner(userId) || isAdmin()) && (
        (isOwner(userId) && (
          // Action: Profile Details Update
          (incoming().role == existing().role && 
           incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'phone', 'address', 'updated_at'])) ||
          // Action: Settings & Avatar Update
          (incoming().role == existing().role && 
           incoming().diff(existing()).affectedKeys().hasOnly(['settings', 'avatar_config', 'avatar_url', 'avatar_style', 'avatar_vibe', 'avatar_generation_count', 'updated_at'])) ||
          // Action: Add Funds (Exact amount match for added security)
          (incoming().role == existing().role && 
           incoming().diff(existing()).affectedKeys().hasOnly(['wallet_balance', 'updated_at']) &&
           incoming().wallet_balance == existing().wallet_balance + 500) ||
          // Action: Rewards update (points, levels, gift redemption)
          (incoming().role == existing().role && 
           incoming().diff(existing()).affectedKeys().hasOnly(['points', 'reward_points', 'total_orders', 'lifetime_spend', 'badge_tier', 'claimedGifts', 'updated_at']))
        )) ||
        isAdmin()
      );
    }

    // MENU: Publicly viewable, Admin managed
    match /menu/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) && isAdmin() && isValidMenuItem(incoming());
      allow update: if isValidId(itemId) && isValidMenuItem(incoming()) && isAdmin();
      allow delete: if isValidId(itemId) && isAdmin();
    }

    // DELIVERY AREAS: Publicly viewable, Admin managed
    match /delivery_areas/{areaId} {
      allow get: if isValidId(areaId);
      allow list: if true;
      allow create: if isValidId(areaId) && isAdmin() && isValidDeliveryArea(incoming());
      allow update: if isValidId(areaId) && isAdmin() && isValidDeliveryArea(incoming());
      allow delete: if isValidId(areaId) && isAdmin();
    }

    // SERVICE PINCODES: Publicly viewable, Admin managed
    match /service_pincodes/{pincodeId} {
      allow get: if isValidId(pincodeId);
      allow list: if true;
      allow create: if isValidId(pincodeId) && isAdmin() && isValidServicePincode(incoming());
      allow update: if isValidId(pincodeId) && isAdmin() && isValidServicePincode(incoming());
      allow delete: if isValidId(pincodeId) && isAdmin();
    }

    // ORDERS: Core Transaction logic
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isOwner(existing().user_id) || isAdmin() || existing().user_id == 'guest');
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      
      allow create: if isValidId(orderId) && isOrderingOpen() && 
                    incoming().keys().hasAll(['user_id', 'customer_name', 'phone', 'items', 'total', 'status', 'address', 'payment_method', 'created_at']) &&
                    incoming().created_at == request.time &&
                    isValidOrder(incoming());
      
      allow update: if isValidId(orderId) && isValidOrder(incoming()) && (isAdmin() || (
        (isOwner(existing().user_id) || existing().user_id == 'guest') && 
        // Prevent changing immutable fields
        incoming().user_id == existing().user_id &&
        incoming().created_at == existing().created_at &&
        (isAdmin() || incoming().updated_at == request.time) &&
        (
          // Action: Customer Cancel
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at']) &&
           existing().status == 'pending' && incoming().status == 'cancelled') ||
          // Action: Pay / Submit UTR
          (incoming().diff(existing()).affectedKeys().hasOnly(['utr', 'payment_status', 'payment_screenshot', 'updated_at']) &&
           existing().status == 'pending')
        )
      ));
      
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // REVIEWS: Based on Order completion
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) && isEmailVerified() && 
                    incoming().keys().hasAll(['order_id', 'user_id', 'customer_name', 'rating', 'comment', 'created_at']) &&
                    incoming().created_at == request.time &&
                    isValidReview(incoming()) &&
                    // Verify the order exists and was delivered to this user
                    get(/databases/$(database)/documents/orders/$(incoming().order_id)).data.user_id == request.auth.uid &&
                    get(/databases/$(database)/documents/orders/$(incoming().order_id)).data.status == 'delivered';
      allow update: if isValidId(reviewId) && isValidReview(incoming()) && (isAdmin() || isOwner(resource.data.user_id));
      allow delete: if isValidId(reviewId) && (isAdmin() || isOwner(resource.data.user_id));
    }

    // WISHLIST: User private vault
    match /wishlist/{wishlistId} {
      allow get: if isValidId(wishlistId) && isOwner(existing().user_id);
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      
      allow create: if isValidId(wishlistId) && isSignedIn() &&
                    isOwner(incoming().user_id) && 
                    isValidWishlistItem(incoming()) && 
                    incoming().keys().hasAll(['user_id', 'item_id', 'item_details', 'added_at']) &&
                    incoming().added_at == request.time;
                    
      allow update: if isValidId(wishlistId) && isSignedIn() &&
                    isValidWishlistItem(incoming()) &&
                    isOwner(existing().user_id) &&
                    incoming().user_id == existing().user_id;
                    
      allow delete: if isValidId(wishlistId) && isSignedIn() && 
                    isOwner(existing().user_id);
    }

    // BANNERS: Marketing
    match /banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create: if isValidId(bannerId) && isAdmin() && isValidBanner(incoming());
      allow update: if isValidId(bannerId) && isValidBanner(incoming()) && isAdmin();
      allow delete: if isValidId(bannerId) && isAdmin();
    }

    // SETTINGS: System Config
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId) && isAdmin() && isValidSettings(settingId, incoming());
    }

    // ADMINS: Master RBAC
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list: if false;
      allow write: if false; // System only
    }

    // COUPONS: Restricted updates for usage count
    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if isAdmin() || (resource.data.status == 'active');
      allow update: if isValidId(couponId) && isValidCoupon(incoming()) && (isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['usage_count']) &&
        incoming().usage_count == existing().usage_count + 1
      ));
      allow create: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming());
      allow delete: if isValidId(couponId) && isAdmin();
    }

    // BADGE CONFIGS & GIFTS
    match /badge_configs/{badgeId} {
      allow get: if isValidId(badgeId);
      allow list: if true;
      allow create: if isValidId(badgeId) && isAdmin() && isValidBadgeConfig(incoming());
      allow update: if isValidId(badgeId) && isValidBadgeConfig(incoming()) && isAdmin();
      allow delete: if isValidId(badgeId) && isAdmin();
    }

    match /gifts/{giftId} {
      allow get: if isValidId(giftId);
      allow list: if true;
      allow create: if isValidId(giftId) && isAdmin() && isValidGift(incoming());
      allow update: if isValidId(giftId) && isValidGift(incoming()) && isAdmin();
      allow delete: if isValidId(giftId) && isAdmin();
    }

    // NOTIFY REQUESTS: Any user can submit, Admin managed
    match /notify_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow create: if isValidId(requestId) && isValidNotifyRequest(incoming());
      allow list, update, delete: if isAdmin();
    }

    // MOBILE OTPS: SMS Verification database
    match /mobile_otps/{phone} {
      allow read, write: if true;
    }

    // TEST CONNECTION: Publicly readable for testing database connectivity status
    match /test/{testId} {
      allow read: if true;
    }
  }
}
