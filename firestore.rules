rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions (The Primitives)
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && 
             request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // RBAC: Admin check via trusted collection lookup
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        // Hardcoded bootstrap admins:
        (request.auth.token.email.lower() in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com", "sayedazainab216@gmail.com", "sayedazainabali76@gmail.com"] && isEmailVerified())
      );
    }

    // Check if the business is accepting orders
    function isOrderingOpen() {
      return get(/databases/$(database)/documents/settings/appConfig).data.isOrderingOpen == true;
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Schema Enforcement)
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'full_name', 'updated_at']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.full_name is string && data.full_name.size() <= 128 &&
             data.role in ['customer', 'admin', 'rider'] &&
             // Size guards for common optional fields
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('points' in data) || (data.points is number && data.points >= 0)) &&
             (!('wallet_balance' in data) || (data.wallet_balance is number && data.wallet_balance >= 0)) &&
             (!('badge_tier' in data) || (data.badge_tier is string && data.badge_tier.size() <= 50)) &&
             (!('total_orders' in data) || (data.total_orders is number && data.total_orders >= 0)) &&
             (!('lifetime_spend' in data) || (data.lifetime_spend is number && data.lifetime_spend >= 0)) &&
             (!('activity_streak' in data) || (data.activity_streak is number && data.activity_streak >= 0)) &&
             (!('referral_count' in data) || (data.referral_count is number && data.referral_count >= 0)) &&
             (!('review_count' in data) || (data.review_count is number && data.review_count >= 0)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('deleted' in data) || data.deleted is bool) &&
             (!('deleted_at' in data) || (data.deleted_at is string && data.deleted_at.size() <= 100)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('avatar_config' in data) || data.avatar_config is map) &&
             (!('ai_usage_stats' in data) || data.ai_usage_stats is map) &&
             (data.updated_at == request.time);
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'available', 'stock_quantity']) &&
             data.name is string && data.name.size() <= 128 &&
             data.price is number && data.price >= 0 &&
             data.stock_quantity is number && data.stock_quantity >= 0 &&
             data.category is string && data.category.size() <= 100 &&
             data.available is bool &&
             (!('image' in data) || (data.image is string && data.image.size() <= 2000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['user_id', 'customer_name', 'phone', 'items', 'total', 'status', 'address', 'payment_method', 'created_at']) &&
             data.customer_name is string && data.customer_name.size() <= 128 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'confirmed', 'assigned', 'preparing', 'out_for_delivery', 'delivered', 'cancelled'] &&
             data.address is string && data.address.size() <= 1000 &&
             data.payment_method is string && data.payment_method.size() <= 50 &&
             (data.user_id == request.auth.uid || data.user_id == 'guest') &&
             (data.created_at == request.time) &&
             (!('discount' in data) || data.discount is number) &&
             (!('coupon_code' in data) || (data.coupon_code is string && data.coupon_code.size() <= 50)) &&
             (!('utr' in data) || (data.utr is string && data.utr.size() <= 128)) &&
             (!('payment_status' in data) || (data.payment_status is string && data.payment_status.size() <= 100)) &&
             (!('updated_at' in data) || (data.updated_at == request.time));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['order_id', 'user_id', 'customer_name', 'rating', 'comment', 'created_at']) &&
             data.order_id is string && data.order_id.size() <= 128 &&
             data.user_id == request.auth.uid &&
             data.customer_name is string && data.customer_name.size() <= 128 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 2000 &&
             (data.created_at == request.time);
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'type', 'value', 'min_order', 'expiry_date', 'usage_limit', 'usage_count', 'status']) &&
             data.code is string && data.code.size() <= 50 &&
             data.type in ['percentage', 'fixed'] &&
             data.value is number && data.value >= 0 &&
             data.min_order is number && data.min_order >= 0 &&
             data.expiry_date is string && data.expiry_date.size() <= 100 &&
             data.usage_limit is number && data.usage_limit >= 0 &&
             data.usage_count is number && data.usage_count >= 0 &&
             data.status in ['active', 'expired', 'disabled'];
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['user_id', 'title', 'message', 'type', 'read', 'created_at']) &&
             data.user_id is string && data.user_id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type in ['order', 'system', 'rider'] &&
             data.read is bool &&
             (data.created_at == request.time) &&
             (!('link' in data) || (data.link is string && data.link.size() <= 2000));
    }

    function isValidBadgeConfig(data) {
      return data.keys().hasAll(['tierName', 'minOrders', 'minSpend', 'priority']) &&
             data.tierName is string && data.tierName.size() <= 100 &&
             data.minOrders is number &&
             data.minSpend is number &&
             data.priority is number &&
             (!('benefits' in data) || data.benefits is list) &&
             (!('themeColor' in data) || data.themeColor is string) &&
             (!('badgeIcon' in data) || data.badgeIcon is string);
    }

    function isValidGift(data) {
      return data.keys().hasAll(['title', 'requiredTier', 'stock', 'active']) &&
             data.title is string && data.title.size() <= 200 &&
             data.requiredTier is string &&
             data.stock is number &&
             data.active is bool;
    }

    // -------------------------------------------------------------------------
    // Match Blocks
    // -------------------------------------------------------------------------

    // NOTIFICATIONS: User private alerts
    match /notifications/{notificationId} {
      allow get: if isOwner(existing().user_id);
      allow list: if isOwner(resource.data.user_id);
      allow create: if (isAdmin() || isOwner(incoming().user_id)) && isValidNotification(incoming());
      allow update: if (isAdmin() || isOwner(existing().user_id)) && 
                    isValidNotification(incoming()) &&
                    incoming().user_id == existing().user_id &&
                    incoming().created_at == existing().created_at &&
                    (
                      // Action: Mark as Read
                      incoming().diff(existing()).affectedKeys().hasOnly(['read'])
                    );
      allow delete: if isAdmin() || isOwner(existing().user_id);
    }

    // USERS: PII Isolation - Private by default
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        // Only allow 'customer' role for standard sign-ups
        incoming().role == 'customer' || isAdmin()
      );
      allow update: if (isOwner(userId) || isAdmin()) && (
        (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'phone', 'address', 'updated_at', 'settings', 'wallet_balance', 'badge_tier', 'total_orders', 'lifetime_spend', 'activity_streak', 'referral_count', 'review_count', 'title', 'points', 'deleted', 'deleted_at', 'status', 'avatar_config', 'ai_usage_stats'])) ||
        isAdmin()
      ) && isValidUser(incoming());
    }

    // MENU: Publicly viewable, Admin managed
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidMenuItem(incoming());
      allow delete: if isAdmin();
    }

    // ORDERS: Core Transaction logic
    match /orders/{orderId} {
      allow get: if isOwner(existing().user_id) || isAdmin() || existing().user_id == 'guest';
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      
      allow create: if isOrderingOpen() && isValidOrder(incoming());
      
      allow update: if isAdmin() || (
        (isOwner(existing().user_id) || existing().user_id == 'guest') && 
        isValidOrder(incoming()) &&
        // Prevent changing immutable fields
        incoming().user_id == existing().user_id &&
        incoming().created_at == existing().created_at &&
        (
          // Action: Customer Cancel
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at']) &&
           existing().status == 'pending' && incoming().status == 'cancelled') ||
          // Action: Pay / Submit UTR
          (incoming().diff(existing()).affectedKeys().hasOnly(['utr', 'payment_status', 'payment_screenshot', 'updated_at']) &&
           existing().status == 'pending')
        )
      );
      
      allow delete: if isAdmin();
    }

    // RIDERS: Location & Availability
    match /riders/{riderId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(riderId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'location', 'last_active'])
      ));
    }

    // REVIEWS: Based on Order completion
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isEmailVerified() && isValidReview(incoming()) &&
                    // Verify the order exists and was delivered to this user
                    get(/databases/$(database)/documents/orders/$(incoming().order_id)).data.user_id == request.auth.uid &&
                    get(/databases/$(database)/documents/orders/$(incoming().order_id)).data.status == 'delivered';
      allow update, delete: if isAdmin() || isOwner(resource.data.user_id);
    }

    // WISHLIST: User private vault
    match /wishlist/{wishlistId} {
      allow read, write: if isOwner(resource.data.user_id || incoming().user_id);
    }

    // BANNERS: Marketing
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SETTINGS: System Config
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ADMINS: Master RBAC
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false; // System only
    }

    // COUPONS: Restricted updates for usage count
    match /coupons/{couponId} {
      allow get: if true;
      allow list: if isAdmin() || (resource.data.status == 'active');
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['usage_count']) &&
        incoming().usage_count == existing().usage_count + 1
      );
      allow create, delete: if isAdmin();
    }

    // BADGE CONFIGS & GIFTS
    match /badge_configs/{badgeId} {
      allow read: if true;
      allow write: if isAdmin() && isValidBadgeConfig(incoming());
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isAdmin() && isValidGift(incoming());
    }
  }
}

