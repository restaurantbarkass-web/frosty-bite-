rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && 
             "email_verified" in request.auth.token && 
             request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOrderingOpen() {
      return get(/databases/$(database)/documents/settings/appConfig).data.isOrderingOpen == true;
    }

    // Admin check logic
    function isAdmin() {
      return isSignedIn() && (
        ("email" in request.auth.token && 
         request.auth.token.email.lower() in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com", "sayedazainab216@gmail.com", "sayedazainabali76@gmail.com"]) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Entity Validators (The Blueprints)
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'full_name', 'updated_at']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.full_name is string && data.full_name.size() <= 100 &&
             data.role in ['customer', 'admin', 'rider'] &&
             (data.updated_at == request.time || data.updated_at is timestamp || data.updated_at is string);
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'available', 'stock_quantity']) &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stock_quantity is number && data.stock_quantity >= 0 &&
             data.category is string &&
             data.available is bool &&
             (!('image' in data) || (data.image is string && data.image.size() <= 2000000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    function isValidOrderSchema(data) {
      return data.keys().hasAll(['user_id', 'customer_name', 'phone', 'items', 'total', 'status', 'address', 'payment_method', 'created_at']) &&
             data.customer_name is string && data.customer_name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 15 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'confirmed', 'assigned', 'preparing', 'out_for_delivery', 'delivered', 'cancelled'] &&
             data.address is string && data.address.size() <= 1000 &&
             data.payment_method in ['upi', 'cod', 'card', 'cash', 'online'] &&
             data.user_id is string && 
             // Handled ISO strings or Timestamps (safeFirestore normalizes to ISO)
             (data.created_at is timestamp || data.created_at is string) &&
             (!('subtotal' in data) || (data.subtotal is number)) &&
             (!('discount' in data) || (data.discount is number)) &&
             (!('coupon_code' in data) || (data.coupon_code is string || data.coupon_code == null)) &&
             (!('utr' in data) || (data.utr is string && data.utr.size() <= 128)) &&
             (!('payment_status' in data) || (data.payment_status is string)) &&
             (!('order_id' in data) || (data.order_id is string)) &&
             (!('rider_id' in data) || (data.rider_id is string)) &&
             (!('rider_name' in data) || (data.rider_name is string)) &&
             (!('estimated_delivery_time' in data) || (data.estimated_delivery_time is number)) &&
             (!('payment_screenshot' in data) || (data.payment_screenshot is string && data.payment_screenshot.size() <= 2000000)) &&
             (!('updated_at' in data) || (data.updated_at is timestamp || data.updated_at is string)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidOrder(data) {
      return isValidOrderSchema(data) &&
             (data.user_id == request.auth.uid || data.user_id == 'guest') &&
             // Handle both serverTimestamp (timestamp) and ISO string (string) fallback
             (data.created_at == request.time || data.created_at is string);
    }

    function isValidRider(data) {
      return data.keys().hasAll(['uid', 'name', 'status']) &&
             data.keys().size() == 3 &&
             data.uid is string && 
             data.name is string && data.name.size() <= 100 &&
             data.status in ['online', 'busy', 'offline', 'on-delivery'];
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll(['isOrderingOpen']) &&
             data.isOrderingOpen is bool;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'type', 'value', 'min_order', 'expiry_date', 'usage_limit', 'usage_count', 'status']) &&
             data.code is string && data.code.size() <= 50 &&
             data.type in ['percentage', 'fixed'] &&
             data.value is number && data.value >= 0 &&
             data.min_order is number && data.min_order >= 0 &&
             data.expiry_date is string &&
             data.usage_limit is number && data.usage_limit >= 0 &&
             data.usage_count is number && data.usage_count >= 0 &&
             data.status in ['active', 'expired', 'disabled'] &&
             (!('is_first_order_only' in data) || data.is_first_order_only is bool) &&
             (!('created_at' in data) || (data.created_at is timestamp || data.created_at is string));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['order_id', 'user_id', 'customer_name', 'rating', 'comment', 'created_at']) &&
             data.order_id is string &&
             data.user_id == request.auth.uid &&
             data.customer_name is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             (data.created_at == request.time || data.created_at is string);
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['user_id', 'item_id', 'item_details', 'added_at']) &&
             data.user_id == request.auth.uid &&
             data.item_id is string &&
             data.item_details is map &&
             (data.added_at == request.time || data.added_at is string);
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------

    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        // Forbid self-assigning admin/rider unless in whitelist
        (incoming().role == 'customer') || 
        (incoming().role == 'admin' && isAdmin()) ||
        ("email" in request.auth.token && 
         ((incoming().role == 'admin' && request.auth.token.email.lower() in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com", "sayedazainab216@gmail.com", "sayedazainabali76@gmail.com"]) ||
          (incoming().role == 'rider' && request.auth.token.email.lower() in ["rider1@gmail.com", "delivery@frostybite.com"])))
      );
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUser(incoming()) && (
                      isAdmin() || 
                      (incoming().role == existing().role) ||
                      // Allow role sync if it matches the whitelist
                      ("email" in request.auth.token && 
                       ((incoming().role == 'admin' && request.auth.token.email.lower() in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com", "sayedazainab216@gmail.com", "sayedazainabali76@gmail.com"]) ||
                        (incoming().role == 'rider' && request.auth.token.email.lower() in ["rider1@gmail.com", "delivery@frostybite.com"])))
                    );
    }

    // WISHLIST
    match /wishlist/{wishlistId} {
      allow get: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && isValidWishlist(incoming()) && wishlistId == request.auth.uid + "_" + incoming().item_id;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // MENU
    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMenuItem(incoming());
      allow delete: if isAdmin();
    }

    // ORDERS
    match /orders/{orderId} {
      allow get: if isSignedIn() || resource.data.user_id == 'guest' || isAdmin();
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin() || (resource.data.keys().hasAll(['rider_id']) && resource.data.rider_id == request.auth.uid));
      
      allow create: if isOrderingOpen() && isValidOrder(incoming());
      
      allow update: if isAdmin() || (
        (isSignedIn() || existing().user_id == 'guest') && (
          // User/Guest action: Cancel if pending
          ((isOwner(existing().user_id) || existing().user_id == 'guest') && 
           incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
           existing().status == 'pending' &&
           incoming().status == 'cancelled') ||
          // User/Guest action: Submit utr for Admin Verification
          ((isOwner(existing().user_id) || existing().user_id == 'guest') &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'utr', 'payment_status', 'payment_screenshot', 'updated_at']) &&
           existing().status == 'pending' &&
           incoming().status == 'pending' &&
           incoming().payment_status == 'pending_verification' &&
           incoming().utr is string && incoming().utr.size() >= 10) ||
          // Rider action: Update delivery status
          (existing().keys().hasAll(['rider_id']) && existing().rider_id == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
           incoming().status in ['out_for_delivery', 'delivered'])
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().user_id) && existing().status == 'pending' && (request.time > existing().created_at + duration.value(60, 'm')));
    }

    // RIDERS
    match /riders/{riderId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(riderId) && isValidRider(incoming()));
    }

    // SETTINGS (App Config & Theme)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ADMINS
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // System managed
    }
    
    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow get: if isOwner(resource.data.user_id);
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isAdmin() || isOwner(incoming().user_id);
      allow update: if isOwner(resource.data.user_id) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.user_id);
    }

    // COUPONS
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCoupon(incoming());
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['usage_count']) &&
        incoming().usage_count == existing().usage_count + 1
      );
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming()) &&
                    get(/databases/$(database)/documents/orders/$(incoming().order_id)).data.user_id == request.auth.uid &&
                    get(/databases/$(database)/documents/orders/$(incoming().order_id)).data.status == 'delivered';
      allow update, delete: if isAdmin() || isOwner(resource.data.user_id);
    }
  }
}
