rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && 
             "email_verified" in request.auth.token && 
             request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin check logic
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["restaurantbarkass@gmail.com", "wasifmd924@gmail.com"] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Entity Validators (The Blueprints)
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().size() >= 3 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['customer', 'admin', 'rider'];
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'available']) &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.available is bool &&
             (!('image' in data) || (data.image is string && data.image.size() <= 2000000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'customerName', 'phone', 'items', 'total', 'status', 'address', 'paymentMethod', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 15 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'assigned', 'preparing', 'out_for_delivery', 'delivered', 'cancelled'] &&
             data.address is string && data.address.size() <= 1000 &&
             data.paymentMethod in ['upi', 'cod', 'card'] &&
             data.createdAt == request.time;
    }

    function isValidRider(data) {
      return data.keys().hasAll(['uid', 'name', 'status']) &&
             data.uid is string && data.name is string && data.name.size() <= 100 &&
             data.status in ['online', 'busy', 'offline'];
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll(['isOrderingOpen']) &&
             data.isOrderingOpen is bool;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------

    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                    incoming().role == existing().role && 
                    isValidUser(incoming());
    }

    // MENU
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidMenuItem(incoming());
    }

    // ORDERS
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin() || existing().riderId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || resource.data.riderId == request.auth.uid);
      
      allow create: if isEmailVerified() && isValidOrder(incoming());
      
      allow update: if isSignedIn() && (
        // Admin action: Full update
        (isAdmin() && isValidOrder(incoming())) ||
        // User action: Cancel if pending
        (isOwner(existing().userId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         existing().status == 'pending' &&
         incoming().status == 'cancelled') ||
        // Rider action: Update delivery status
        (existing().riderId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         incoming().status in ['out_for_delivery', 'delivered'])
      );
    }

    // RIDERS
    match /riders/{riderId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(riderId) && isValidRider(incoming()));
    }

    // SETTINGS (App Config & Theme)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ADMINS
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // System managed
    }
    
    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || isOwner(incoming().userId);
      allow update: if isOwner(resource.data.userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
