{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a user account and their role in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "full_name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "points": { "type": "number" },
        "wallet_balance": { "type": "number" },
        "badge_tier": { "type": "string" },
        "total_orders": { "type": "number" },
        "lifetime_spend": { "type": "number" },
        "activity_streak": { "type": "number" },
        "referral_count": { "type": "number" },
        "review_count": { "type": "number" },
        "title": { "type": "string" },
        "avatar_config": { "type": "object" },
        "avatar_url": { "type": "string" },
        "avatar_style": { "type": "string" },
        "avatar_vibe": { "type": "string" },
        "avatar_generation_count": { "type": "number" },
        "ai_usage_stats": { "type": "object" },
        "fcm_tokens": { "type": "array" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "MenuItem": {
      "title": "Bakery Item",
      "description": "An item on the bakery menu.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "available": { "type": "boolean" },
        "description": { "type": "string" },
        "stock_quantity": { "type": "number" }
      },
      "required": ["name", "price", "category", "available", "stock_quantity"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "Details of a customer purchase.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "phone": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "preparing", "delivered", "cancelled"] },
        "address": { "type": "string" },
        "payment_method": { "type": "string" },
        "utr": { "type": "string" },
        "payment_status": { "type": "string" },
        "order_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "customer_name", "phone", "items", "total", "status", "address"]
    },
    "AppConfig": {
      "title": "App Configuration",
      "description": "Global settings for the application.",
      "type": "object",
      "properties": {
        "isOrderingOpen": { "type": "boolean" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["isOrderingOpen"]
    },
    "ThemeSettings": {
      "title": "Theme Settings",
      "description": "Visual customization and global branding for the app.",
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "surfaceColor": { "type": "string" },
        "fontFamily": { "type": "string" },
        "borderRadius": { "type": "string" },
        "darkMode": { "type": "boolean" },
        "offerText": { "type": "string" },
        "showOfferBanner": { "type": "boolean" },
        "offerLink": { "type": "string" },
        "offerColor": { "type": "string" }
      }
    },
    "Coupon": {
      "title": "Discount Coupon",
      "description": "Promotional codes for discounts.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "min_order": { "type": "number" },
        "expiry_date": { "type": "string", "format": "date" },
        "usage_limit": { "type": "number" },
        "usage_count": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expired", "disabled"] },
        "is_first_order_only": { "type": "boolean" },
        "allowedTiers": { "type": "array" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "type", "value", "min_order", "expiry_date", "usage_limit", "usage_count", "status"]
    },
    "BadgeConfig": {
      "title": "Badge Configuration",
      "description": "Defines tiers and their requirements/benefits.",
      "type": "object",
      "properties": {
        "tierName": { "type": "string" },
        "minOrders": { "type": "number" },
        "minSpend": { "type": "number" },
        "benefits": { "type": "array" },
        "couponIds": { "type": "array" },
        "giftIds": { "type": "array" },
        "freeDelivery": { "type": "boolean" },
        "cashbackPercent": { "type": "number" },
        "prioritySupport": { "type": "boolean" },
        "themeColor": { "type": "string" },
        "badgeIcon": { "type": "string" },
        "priority": { "type": "number" }
      },
      "required": ["tierName", "minOrders", "minSpend", "priority"]
    },
    "Gift": {
      "title": "Reward Gift",
      "description": "Physical or digital rewards for users.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "requiredTier": { "type": "string" },
        "stock": { "type": "number" },
        "active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "requiredTier", "stock", "active"]
    },
    "Review": {
      "title": "Order Review",
      "description": "Feedback from a customer about their order.",
      "type": "object",
      "properties": {
        "order_id": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["order_id", "user_id", "customer_name", "rating", "comment", "created_at"]
    },
    "Banner": {
      "title": "Promotional Banner",
      "description": "Marketing banners for the home and offers pages.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "redirect_url": { "type": "string" },
        "is_active": { "type": "boolean" },
        "is_flash_deal": { "type": "boolean" },
        "auto_apply_coupon": { "type": "string" },
        "priority": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "image", "is_active", "priority"]
    },
    "WishlistItem": {
      "title": "Wishlist Item",
      "description": "A food item saved by a user for future reference.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "item_id": { "type": "string" },
        "item_details": { "$ref": "#/entities/MenuItem" },
        "added_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "item_id", "item_details", "added_at"]
    },
    "Notification": {
      "title": "User Notification",
      "description": "Alerts and messages for the user.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["order", "system"] },
        "read": { "type": "boolean" },
        "link": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "title", "message", "type", "read", "created_at"]
    },
    "ServiceZone": {
      "title": "Service Zone",
      "description": "Represents an operational delivery radius/zone for a specific city.",
      "type": "object",
      "properties": {
        "city_name": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radius_meters": { "type": "number" },
        "is_active": { "type": "boolean" }
      },
      "required": ["city_name", "latitude", "longitude", "radius_meters", "is_active"]
    },
    "ServicePincode": {
      "title": "Service Pincode",
      "description": "Represents an operational delivery pincode.",
      "type": "object",
      "properties": {
        "pincode": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["pincode", "active"]
    },
    "DeliveryArea": {
      "title": "Delivery Area",
      "description": "Represents a specific named delivery area and whether it is deliverable.",
      "type": "object",
      "properties": {
        "area_name": { "type": "string" },
        "pincode": { "type": "string" },
        "is_deliverable": { "type": "boolean" }
      },
      "required": ["area_name", "pincode", "is_deliverable"]
    },
    "NotifyRequest": {
      "title": "Notify Request",
      "description": "Represents a user request to be notified when service in their area becomes operational.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "coords": { "type": "object" },
        "created_at": { "type": "string" }
      },
      "required": ["email", "created_at"]
    },
    "MobileOtp": {
      "title": "Mobile OTP",
      "description": "Represents a mobile verification OTP or signature for phone login in-progress.",
      "type": "object",
      "properties": {
        "otp": { "type": "string" },
        "expires_at": { "type": "number" },
        "email": { "type": "string" },
        "isSignup": { "type": "boolean" },
        "name": { "type": "string" },
        "password": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["otp", "expires_at"]
    }
  },
  "firestore": {
    "delivery_areas/{areaId}": {
      "schema": "DeliveryArea",
      "description": "Names and status of delivery areas."
    },
    "service_pincodes/{pincodeId}": {
      "schema": "ServicePincode",
      "description": "List of delivery pincodes and their eligibility status."
    },
    "service_zones/{zoneId}": {
      "schema": "ServiceZone",
      "description": "Information about active/inactive delivery service areas."
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Storage for user profile data."
    },
    "menu/{itemId}": {
      "schema": "MenuItem",
      "description": "Bakery menu items."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer order records."
    },
    "settings/appConfig": {
      "schema": "AppConfig",
      "description": "Global application state."
    },
    "settings/theme": {
      "schema": "ThemeSettings",
      "description": "Global theme configuration."
    },
    "coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional discount codes."
    },
    "banners/{bannerId}": {
      "schema": "Banner",
      "description": "Marketing and promotional banners."
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer feedback and ratings."
    },
    "wishlist/{wishlistId}": {
      "schema": "WishlistItem",
      "description": "User's saved food items."
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User alerts and updates."
    },
    "badge_configs/{badgeId}": {
      "schema": "BadgeConfig",
      "description": "Global tier requirements and benefits."
    },
    "gifts/{giftId}": {
      "schema": "Gift",
      "description": "Rewards available for users."
    },
    "notify_requests/{requestId}": {
      "schema": "NotifyRequest",
      "description": "User notification requests for unserved locations."
    },
    "mobile_otps/{phone}": {
      "schema": "MobileOtp",
      "description": "Transient storage for verifying mobile devices."
    }
  }
}
