{
  "name": "frosty-bite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild api/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=api/index.js",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "version:bump": "node scripts/version-manager.js",
    "version:dev": "node scripts/version-manager.js --stage=dev --type=minor --no-git",
    "version:beta": "node scripts/version-manager.js --stage=beta --type=minor",
    "version:release": "node scripts/version-manager.js --stage=production --type=minor"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@dicebear/adventurer": "^9.4.2",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@google/genai": "^2.3.0",
    "@huggingface/inference": "^4.13.15",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/vite": "4.0.12",
    "@turf/turf": "^7.4.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "bullmq": "^5.80.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "gsap": "^3.15.0",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^5.11.1",
    "jimp": "^1.6.1",
    "jspdf": "^4.2.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.3.0",
    "motion": "^12.4.7",
    "nodemailer": "^8.0.7",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.1.0",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.0.12",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "6.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
